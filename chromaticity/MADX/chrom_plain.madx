! (a) plain MAD-X TWISS. Deuteron, m=1.875612945 GeV, Ekin=0.270 GeV.
OPTION, -ECHO, -INFO;
BEAM, PARTICLE=DEUTERON, MASS=1.875612945, CHARGE=1, ENERGY=1.875612945+0.270;
CALL, FILE="magnetic_2_md.seq";
USE, SEQUENCE=RING;
SELECT, FLAG=TWISS, CLEAR;
SELECT, FLAG=TWISS, COLUMN=NAME,S,L,BETX,ALFX,BETY,ALFY,DX,DPX,MUX,MUY;
TWISS, FILE="output/twiss_plain.tfs";
VALUE, BEAM->BRHO, BEAM->GAMMA, BEAM->BETA, BEAM->PC;
B0 = BEAM->BETA; G0 = BEAM->GAMMA;
Q1_ = TABLE(SUMM,Q1); Q2_ = TABLE(SUMM,Q2);
DQ1_PT = TABLE(SUMM,DQ1); DQ2_PT = TABLE(SUMM,DQ2);
ALFA_ = TABLE(SUMM,ALFA); LEN_ = TABLE(SUMM,LENGTH);
TWISS, CHROM, FILE="output/twiss_chrom.tfs";
DQ1C_PT = TABLE(SUMM,DQ1); DQ2C_PT = TABLE(SUMM,DQ2);
! d/d(delta) = beta0 * d/d(PT)  (PT = dE/(p0 c) = beta0*delta to 1st order)
ETA_ = ALFA_ - 1/(G0*G0);
SET, FORMAT="22.12g";
ASSIGN, ECHO="output/madx_plain_results.txt";
PRINTF, TEXT="# MAD-X plain TWISS; DQ is dQ/dPT; *_dp = beta0*DQ = dQ/d(dp/p)";
PRINTF, TEXT="length = %.7f", VALUE=LEN_;
PRINTF, TEXT="beta0 = %.9f", VALUE=B0;
PRINTF, TEXT="gamma0 = %.9f", VALUE=G0;
PRINTF, TEXT="Q1 = %.8f", VALUE=Q1_;
PRINTF, TEXT="Q2 = %.8f", VALUE=Q2_;
PRINTF, TEXT="alfa = %.8f", VALUE=ALFA_;
PRINTF, TEXT="eta = %.8f", VALUE=ETA_;
PRINTF, TEXT="DQ1_pt = %.6f", VALUE=DQ1_PT;
PRINTF, TEXT="DQ2_pt = %.6f", VALUE=DQ2_PT;
PRINTF, TEXT="DQ1_dp = %.6f", VALUE=DQ1_PT*B0;
PRINTF, TEXT="DQ2_dp = %.6f", VALUE=DQ2_PT*B0;
PRINTF, TEXT="DQ1_chrom_pt = %.6f", VALUE=DQ1C_PT;
PRINTF, TEXT="DQ2_chrom_pt = %.6f", VALUE=DQ2C_PT;
PRINTF, TEXT="DQ1_chrom_dp = %.6f", VALUE=DQ1C_PT*B0;
PRINTF, TEXT="DQ2_chrom_dp = %.6f", VALUE=DQ2C_PT*B0;
ASSIGN, ECHO=TERMINAL;
! finite-difference check in dp/p: TWISS at DELTAP=+-1e-4 (DELTAP is dp/p in MAD-X)
TWISS, DELTAP=1.0E-4; QP1=TABLE(SUMM,Q1); QP2=TABLE(SUMM,Q2);
TWISS, DELTAP=-1.0E-4; QM1=TABLE(SUMM,Q1); QM2=TABLE(SUMM,Q2);
ASSIGN, ECHO="output/madx_plain_results.txt", TRUNCATE=FALSE;
PRINTF, TEXT="DQ1_fd_dp = %.6f", VALUE=(QP1-QM1)/2.0E-4;
PRINTF, TEXT="DQ2_fd_dp = %.6f", VALUE=(QP2-QM2)/2.0E-4;
ASSIGN, ECHO=TERMINAL;
STOP;
