! magnetic_2_md.seq -- full ring from C:\GIT_REPOS\SCT_2\lattice\magnetic_2_md.opt
! Gradients in OptiM kG/cm -> T/m (x10), k = G/Brho, Brho from BEAM.
BRHO_ := BEAM->BRHO;
BM  : SBEND, L=5.3294148, ANGLE=22.5*PI/180, E1=0, E2=0, FINT=0, HGAP=0;
OBM : DRIFT, L=5.3294148;
OS1 : DRIFT, L=0.12;
OS2 : DRIFT, L=0.06;
QF  : QUADRUPOLE, L=0.21, K1:= 1.81168058/BRHO_;
QD  : QUADRUPOLE, L=0.21, K1:=-2.01793283/BRHO_;
QF1 : QUADRUPOLE, L=0.21, K1:= 1.93455213/BRHO_;
QD1 : QUADRUPOLE, L=0.21, K1:=-1.93455213/BRHO_;
SF1 : SEXTUPOLE, L=0.12, K2=0;
SF2 : SEXTUPOLE, L=0.12, K2=0;
SD  : SEXTUPOLE, L=0.12, K2=0;
ARC : LINE=(OS2,QF,BM,QD,OS1,QD,BM,QF,SF2,
            QF,BM,QD,SD, QD,BM,QF,SF1,
            QF,BM,QD,SD, QD,BM,QF,SF2,
            QF,BM,QD,OS1,QD,BM,QF,OS2);
STR : LINE=(OS2,QF1,OBM,QD1,OS1,QD1,OBM,QF1,OS2);
RING: LINE=(ARC,STR,ARC,STR);
