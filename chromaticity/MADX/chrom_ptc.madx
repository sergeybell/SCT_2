! (b) advanced: PTC as in C:\GIT_REPOS\NICA\MADX\2.Programms\Twiss\Compaction.madx
! (ptc_create_layout model=2 method=6 nst=20 exact time=false; ptc_twiss icase=56 no=5)
! plus ptc_normal for higher-order chromaticity / compaction. time=false => delta = dp/p.
OPTION, -ECHO, -INFO;
BEAM, PARTICLE=DEUTERON, MASS=1.875612945, CHARGE=1, ENERGY=1.875612945+0.270;
CALL, FILE="magnetic_2_md.seq";
USE, SEQUENCE=RING;
PTC_CREATE_UNIVERSE;
PTC_CREATE_LAYOUT, MODEL=2, METHOD=6, NST=20, EXACT=TRUE, CLOSED_LAYOUT=TRUE, TIME=FALSE;
SELECT, FLAG=TWISS, CLEAR;
SELECT, FLAG=TWISS, COLUMN=NAME,S,L,BETA11,BETA22,DISP1,DISP2;
PTC_TWISS, TABLE=TWISS, ICASE=56, NO=5, FILE="output/ptc_twiss.tfs", CLOSED_ORBIT, DELTAP=0.0;
WRITE, TABLE=PTC_TWISS_SUMMARY, FILE="output/ptc_twiss_summary.tfs";
SELECT_PTC_NORMAL, Q1=0, Q2=0;
SELECT_PTC_NORMAL, DQ1=1, DQ2=1;
SELECT_PTC_NORMAL, DQ1=2, DQ2=2;
SELECT_PTC_NORMAL, DQ1=3, DQ2=3;
SELECT_PTC_NORMAL, ANHX=1,0,0, ANHY=0,1,0;
PTC_NORMAL, NORMAL, CLOSED_ORBIT, ICASE=5, NO=5, DELTAP=0.0, MAPTABLE=FALSE;
WRITE, TABLE=NORMAL_RESULTS, FILE="output/ptc_normal.tfs";
PTC_END;
STOP;


