OPTION, -ECHO, -INFO, -WARN;
BEAM, PARTICLE=DEUTERON, MASS=1.875612945, CHARGE=1, ENERGY=1.875612945+0.270;
CALL, FILE="magnetic_2_md.seq";
USE, SEQUENCE=RING;
B0 = BEAM->BETA;
SELECT, FLAG=TWISS, CLEAR;
SELECT, FLAG=TWISS, COLUMN=NAME,KEYWORD,S,L,ANGLE,BETX,ALFX,BETY,ALFY,DX,DPX;
TWISS, CHROM, FILE="output/twiss_bends.tfs";
ASSIGN, ECHO="output/edge_tests.txt";
PRINTF, TEXT="T1 MAD-X TWISS thick SBEND (E1=E2=0)           DQ2_dp = %.6f", VALUE=TABLE(SUMM,DQ2)*B0;
ASSIGN, ECHO=TERMINAL;
! PTC variants
PTC_CREATE_UNIVERSE; PTC_CREATE_LAYOUT, MODEL=2, METHOD=6, NST=20, EXACT=TRUE, TIME=FALSE;
PTC_SETSWITCH, FRINGE=FALSE;
SELECT_PTC_NORMAL, DQ1=1, DQ2=1; PTC_NORMAL, NORMAL, CLOSED_ORBIT, ICASE=5, NO=3; 
X1=TABLE(NORMAL_RESULTS,VALUE,2); PTC_END;
SELECT_PTC_NORMAL, CLEAR;
ASSIGN, ECHO="output/edge_tests.txt", TRUNCATE=FALSE;
PRINTF, TEXT="T2 PTC exact model2 fringe=false                 DQ2_dp = %.6f", VALUE=X1;
ASSIGN, ECHO=TERMINAL;
! thin-lens version (MAKETHIN): dipoles become thin kicks, no edge kinematics
SELECT, FLAG=MAKETHIN, CLASS=SBEND, SLICE=64;
SELECT, FLAG=MAKETHIN, CLASS=QUADRUPOLE, SLICE=16;
MAKETHIN, SEQUENCE=RING, STYLE=TEAPOT;
USE, SEQUENCE=RING;
TWISS, CHROM;
ASSIGN, ECHO="output/edge_tests.txt", TRUNCATE=FALSE;
PRINTF, TEXT="T3 MAD-X TWISS after MAKETHIN (thin bends)       Q2 = %.6f DQ2_dp = %.6f", VALUE=TABLE(SUMM,Q2),TABLE(SUMM,DQ2)*B0;
PRINTF, TEXT="                                                 DQ1_dp = %.6f", VALUE=TABLE(SUMM,DQ1)*B0;
ASSIGN, ECHO=TERMINAL;
STOP;
