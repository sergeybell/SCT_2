{ magnetic_2_md lattice (C:\GIT_REPOS\SCT_2\lattice\magnetic_2_md.opt) for COSY INFINITY.
  Deuteron m = 1875.612945 MeV, Ekin = 270 MeV. Hard-edge sector bends (FR 0, no edge angles). }
INCLUDE 'COSY';
PROCEDURE RUN;
VARIABLE MD 1; VARIABLE EK 1; VARIABLE G0 1; VARIABLE B0 1; VARIABLE F 1;
VARIABLE AP 1; VARIABLE LB 1; VARIABLE RB 1; VARIABLE ANG 1;
VARIABLE GQF 1; VARIABLE GQD 1; VARIABLE GQF1 1; VARIABLE GQD1 1;
VARIABLE MU 1000 3; VARIABLE XK 1; VARIABLE YK 1; VARIABLE C 1;
VARIABLE DK 1; VARIABLE QXP 1; VARIABLE QXM 1; VARIABLE QYP 1; VARIABLE QYM 1;
VARIABLE DD 1; VARIABLE CX 1; VARIABLE CY 1; VARIABLE SX 1; VARIABLE SY 1; VARIABLE QX 1; VARIABLE QY 1; VARIABLE TX 1; VARIABLE TY 1; VARIABLE DDP 1; VARIABLE DET 1; VARIABLE L6 1; VARIABLE ETA 1;
PROCEDURE INITPAR;
  MD := 1875.612945; EK := 270;
  G0 := 1+EK/MD; B0 := SQRT(1-1/(G0*G0));
  F := 1+1/G0;   { delta_K = (1+1/gamma) * delta_p }
  AP := 0.05; LB := 5.3294148; ANG := 22.5; RB := LB/(ANG*PI/180);
  { OptiM kG/cm -> T/m (x10); MQ takes pole-tip field G*AP }
  GQF := 1.81168058; GQD := -2.01793283; GQF1 := 1.93455213; GQD1 := -1.93455213;
ENDPROCEDURE;
PROCEDURE SETP E; RP E MD/AMUMEV 1; ENDPROCEDURE;
PROCEDURE EBM; MS RB ANG AP 0 0 0 0 0; ENDPROCEDURE;
PROCEDURE EQF; MQ 0.21 GQF*AP AP; ENDPROCEDURE;
PROCEDURE EQD; MQ 0.21 GQD*AP AP; ENDPROCEDURE;
PROCEDURE EQF1; MQ 0.21 GQF1*AP AP; ENDPROCEDURE;
PROCEDURE EQD1; MQ 0.21 GQD1*AP AP; ENDPROCEDURE;
PROCEDURE ESX; MH 0.12 0 AP; ENDPROCEDURE; {SF1/SF2/SD, strength 0}
PROCEDURE EOS1; DL 0.12; ENDPROCEDURE;
PROCEDURE EOS2; DL 0.06; ENDPROCEDURE;
PROCEDURE EOBM; DL LB; ENDPROCEDURE;
PROCEDURE LARC;
  EOS2; EQF; EBM; EQD; EOS1; EQD; EBM; EQF; ESX;
  EQF; EBM; EQD; ESX; EQD; EBM; EQF; ESX;
  EQF; EBM; EQD; ESX; EQD; EBM; EQF; ESX;
  EQF; EBM; EQD; EOS1; EQD; EBM; EQF; EOS2;
ENDPROCEDURE;
PROCEDURE LSTR; EOS2; EQF1; EOBM; EQD1; EOS1; EQD1; EOBM; EQF1; EOS2; ENDPROCEDURE;
PROCEDURE RING; UM; LARC; LSTR; LARC; LSTR; ENDPROCEDURE;  { OV 3 3 0: TP is not applicable to a 6D map without longitudinal motion
    (COSY stops with "ERROR in GT, unrepresentable map"), so the tunes and their
    delta_K derivative are read from the map coefficients on the off-energy closed orbit:
      Tr_x(dK) = (x|x)+(a|a) + dK*[ (x|xd)+(a|ad) + 2(x|xx)D + (x|xa)D' + (a|xa)D + 2(a|aa)D' ]
      Tr_y(dK) = (y|y)+(b|b) + dK*[ (y|yd)+(b|bd) + (y|yx)D + (y|ya)D' + (b|bx)D + (b|ba)D' ]
      cos(2 pi Q) = Tr/2  =>  dQ/d dK = -(dTr/d dK) / (4 pi sin 2 pi Q)                         }
  OV 3 3 0; INITPAR; FR 0;
  SETP EK; RING; C := SPOS;
  DET := (1-ME(1,1))*(1-ME(2,2))-ME(1,2)*ME(2,1);
  DD  := ((1-ME(2,2))*ME(1,6) + ME(1,2)*ME(2,6))/DET;
  DDP := (ME(2,1)*ME(1,6) + (1-ME(1,1))*ME(2,6))/DET;
  CX := (ME(1,1)+ME(2,2))/2; CY := (ME(3,3)+ME(4,4))/2;
  SX := SQRT(1-CX*CX); IF ME(1,2)<0; SX := -SX; ENDIF;
  SY := SQRT(1-CY*CY); IF ME(3,4)<0; SY := -SY; ENDIF;
  QX := ATAN(SX/CX)/(2*PI); IF CX<0; QX := QX+0.5; ENDIF; IF QX<0; QX := QX+1; ENDIF;
  QY := ATAN(SY/CY)/(2*PI); IF CY<0; QY := QY+0.5; ENDIF; IF QY<0; QY := QY+1; ENDIF;
  TX := ME(1,16)+ME(2,26) + 2*ME(1,11)*DD + ME(1,12)*DDP + ME(2,12)*DD + 2*ME(2,22)*DDP;
  TY := ME(3,36)+ME(4,46) + ME(3,13)*DD + ME(3,23)*DDP + ME(4,14)*DD + ME(4,24)*DDP;
  XK := -TX/(4*PI*SX); YK := -TY/(4*PI*SY);
  L6  := ME(5,1)*DD + ME(5,2)*DDP + ME(5,6);
  { COSY l = -(t-t0) v0 gamma/(1+gamma)  =>  dT/T = -l*(1+1/gamma)/C per dK ; per delta_p another (1+1/gamma) }
  ETA := -L6/C*F*F;
  OPENF 20 'C:/GIT_REPOS/SCT_2/chromaticity/COSY/output/cosy_ov330.txt' 'UNKNOWN';
  WRITE 20 '# COSY OV 3 3 0, order 3: 6D map at fixed fields, delta_K = dK/K is phase-space coordinate 6';
  WRITE 20 '# chromaticity from map coefficients on the off-energy closed orbit (TP not applicable)';
  WRITE 20 '# xi_p = dQ/d(dp/p) = (1+1/gamma0) * dQ/d delta_K';
  WRITE 20 'gamma0 = '&ST(G0);
  WRITE 20 'factor_1p1g = '&ST(F);
  WRITE 20 'length = '&ST(C);
  WRITE 20 'Qx_frac = '&ST(QX);
  WRITE 20 'Qy_frac = '&ST(QY);
  WRITE 20 'dQx_ddK_raw = '&ST(XK);
  WRITE 20 'dQy_ddK_raw = '&ST(YK);
  WRITE 20 'xi_x_p = '&ST(XK*F);
  WRITE 20 'xi_y_p = '&ST(YK*F);
  WRITE 20 'Dx_dK = '&ST(DD);
  WRITE 20 'Dx_p = '&ST(DD*F);
  WRITE 20 'l_dK_closed = '&ST(L6);
  WRITE 20 'eta = '&ST(ETA);
  WRITE 20 'alpha_c = '&ST(ETA+1/(G0*G0));
  CLOSEF 20;
ENDPROCEDURE;
RUN; END;
