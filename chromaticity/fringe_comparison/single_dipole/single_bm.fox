{ single_bm.fox - lone dipole BM of magnetic_2_md, FR 0 / FR 3 (GAP = 0.05, 0.025, 0.0125), OV 3 2 1, printed by PM:
    output/map_<i>.txt   : DL 0.5; BM; DL 0.5
    output/mapbm_<i>.txt : bare BM (as in the ring, where BM touches the quadrupoles)
  i = 1 FR0, 2 FR3 GAP 0.05, 3 FR3 0.025, 4 FR3 0.0125.  COSY coordinates x,a,y,b,l,dK (dK = 5th/param variable). }
INCLUDE '../../COSY/lattice_md';
PROCEDURE RUN;
  VARIABLE RB 1; VARIABLE LB 1; VARIABLE I 1; VARIABLE FRV 1 4; VARIABLE GV 1 4; VARIABLE NM 80;
  OV 3 2 1; LB := 5.3294148; RB := LB/(22.5*PI/180);
  FRV(1):=0; GV(1):=0.05; FRV(2):=3; GV(2):=0.05; FRV(3):=3; GV(3):=0.025; FRV(4):=3; GV(4):=0.0125;
  LOOP I 1 4;
    PART 270*PARA(1); UM; FR 0; DL 0.5; FR FRV(I); MS RB 22.5 GV(I) 0 0 0 0 0; FR 0; DL 0.5;
    NM := 'output/map_'&SI(I)&'.txt'; OPENF 30 NM 'UNKNOWN'; PM 30; CLOSEF 30;
    PART 270*PARA(1); UM; FR FRV(I); MS RB 22.5 GV(I) 0 0 0 0 0; FR 0;
    NM := 'output/mapbm_'&SI(I)&'.txt'; OPENF 30 NM 'UNKNOWN'; PM 30; CLOSEF 30;
  ENDLOOP;
ENDPROCEDURE;
RUN; END;
