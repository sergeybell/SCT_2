{ ************************************************************ }
{ COSY Infinity Lattice Converter }
{ Purpose: Conversion from MADX to COSY Infinity }
{ Author: Kolokolchikov S. }
{ Date: 2026-04-07 17:38:29 }
{ Input file: C:/GIT_REPOS/SCT/MADX/1.Sequences/magnetic.seq }
{ TOTAL ELEMENTS: 300 }
{ ************************************************************ }

INCLUDE 'header';

PROCEDURE LATTICE SEXTGx1 SEXTGy1 SEXTGx2 SEXTGy2 EB1 RFFLAG MAPARR SPNRARR;
 VARIABLE VRF 1 1 1; VARIABLE FREQ 1; VARIABLE HNUM 1; VARIABLE I 1;
 VARIABLE A 1; VARIABLE LEN_S_1 1; VARIABLE LEN_S 1; VARIABLE EBE 1;
 VARIABLE LACC 1;
 VARIABLE QF 1;
 VARIABLE QD 1;
 VARIABLE QF1 1;
 VARIABLE QD1 1;
 VARIABLE L_BM 1;
 VARIABLE ANG_BM 1;
 VARIABLE L_OBM 1;
 VARIABLE L_O2 1; VARIABLE L_O1 1;
 VARIABLE L_QF 1;
 VARIABLE L_QD 1;
 VARIABLE L_QF1 1;
 VARIABLE L_QD1 1;
 VARIABLE SF1 1; VARIABLE SF2 1; VARIABLE SD 1; VARIABLE SD1 1;

 {LATTICE PARAMETERS}
 EBE := EB1; A := 0.05; LEN_S := 0.15; LEN_S_1 := 0.000001;
 SF1 := SEXTGx1; SF2 := SEXTGx2; SD := SEXTGy1; SD1 := SEXTGy2;
 LACC := 161;

 {ELEMENT VALUES FROM MADX}
 L_BM := 2.13176595;
 ANG_BM := 0.1570796324;
 L_OBM := 2.13176595;
 L_O2 := 0.25;
 L_QF := 0.21;
 QF := 1.137641804;
 L_QD := 0.2;
 QD := -1.234003373;
 L_QF1 := 0.2;
 QF1 := 1.351938428;
 L_QD1 := 0.2;
 QD1 := -1.294409133;
 L_O1 := 0.1;

 {SETTING RF PARAMETERS}
 HNUM := 5; VRF(1, 1) := 5; FREQ := HNUM*REVFREQ(LACC);
 UM; CR; IF RFFLAG=1; RF VRF 0 FREQ 0 0.05; ENDIF;

 {BEGIN LATTICE}
    UM; QUAD L_QF A QF ; {QF} SMAPS 1 MAPARR SPNRARR;
    UM; DL L_O2 ; {O2} SMAPS 2 MAPARR SPNRARR;
    UM; SBEND L_BM ANG_BM 0 0 0 0 0 0.5 0.5 ; {BM} SMAPS 3 MAPARR SPNRARR;
    UM; DL L_O2 ; {O2} SMAPS 4 MAPARR SPNRARR;
    UM; QUAD 2*L_QD A QD ; {2 QD} SMAPS 5 MAPARR SPNRARR;
    UM; DL L_O2 ; {O2} SMAPS 6 MAPARR SPNRARR;
    UM; SBEND L_BM ANG_BM 0 0 0 0 0 0.5 0.5 ; {BM} SMAPS 7 MAPARR SPNRARR;
    UM; DL L_O1 ; {O1} SMAPS 8 MAPARR SPNRARR;
    UM; MH LEN_S SF1 0.05; {SF1} SMAPS 9 MAPARR SPNRARR;
    UM; QUAD 2*L_QF A QF ; {2 QF} SMAPS 10 MAPARR SPNRARR;
    UM; DL L_O2 ; {O2} SMAPS 11 MAPARR SPNRARR;
    UM; SBEND L_BM ANG_BM 0 0 0 0 0 0.5 0.5 ; {BM} SMAPS 12 MAPARR SPNRARR;
    UM; DL L_O1 ; {O1} SMAPS 13 MAPARR SPNRARR;
    UM; MH LEN_S SD 0.05; {SD} SMAPS 14 MAPARR SPNRARR;
    UM; QUAD 2*L_QD A QD ; {2 QD} SMAPS 15 MAPARR SPNRARR;
    UM; DL L_O2 ; {O2} SMAPS 16 MAPARR SPNRARR;
    UM; SBEND L_BM ANG_BM 0 0 0 0 0 0.5 0.5 ; {BM} SMAPS 17 MAPARR SPNRARR;
    UM; DL L_O1 ; {O1} SMAPS 18 MAPARR SPNRARR;
    UM; MH LEN_S SF2 0.05; {SF2} SMAPS 19 MAPARR SPNRARR;
    UM; QUAD 2*L_QF A QF ; {2 QF} SMAPS 20 MAPARR SPNRARR;
    UM; DL L_O2 ; {O2} SMAPS 21 MAPARR SPNRARR;
    UM; SBEND L_BM ANG_BM 0 0 0 0 0 0.5 0.5 ; {BM} SMAPS 22 MAPARR SPNRARR;
    UM; DL L_O1 ; {O1} SMAPS 23 MAPARR SPNRARR;
    UM; MH LEN_S SD 0.05; {SD} SMAPS 24 MAPARR SPNRARR;
    UM; QUAD 2*L_QD A QD ; {2 QD} SMAPS 25 MAPARR SPNRARR;
    UM; DL L_O2 ; {O2} SMAPS 26 MAPARR SPNRARR;
    UM; SBEND L_BM ANG_BM 0 0 0 0 0 0.5 0.5 ; {BM} SMAPS 27 MAPARR SPNRARR;
    UM; DL L_O1 ; {O1} SMAPS 28 MAPARR SPNRARR;
    UM; MH LEN_S SF1 0.05; {SF1} SMAPS 29 MAPARR SPNRARR;
    UM; QUAD 2*L_QF A QF ; {2 QF} SMAPS 30 MAPARR SPNRARR;
    UM; DL L_O2 ; {O2} SMAPS 31 MAPARR SPNRARR;
    UM; SBEND L_BM ANG_BM 0 0 0 0 0 0.5 0.5 ; {BM} SMAPS 32 MAPARR SPNRARR;
    UM; DL L_O2 ; {O2} SMAPS 33 MAPARR SPNRARR;
    UM; QUAD 2*L_QD A QD ; {2 QD} SMAPS 34 MAPARR SPNRARR;
    UM; DL L_O2 ; {O2} SMAPS 35 MAPARR SPNRARR;
    UM; SBEND L_BM ANG_BM 0 0 0 0 0 0.5 0.5 ; {BM} SMAPS 36 MAPARR SPNRARR;
    UM; DL L_O2 ; {O2} SMAPS 37 MAPARR SPNRARR;
    UM; QUAD L_QF A QF ; {QF} SMAPS 38 MAPARR SPNRARR;
    UM; QUAD L_QF1 A QF1 ; {QF1} SMAPS 39 MAPARR SPNRARR;
    UM; DL L_O2 ; {O2} SMAPS 40 MAPARR SPNRARR;
    UM; DL L_OBM ; {OBM} SMAPS 41 MAPARR SPNRARR;
    UM; DL L_O2 ; {O2} SMAPS 42 MAPARR SPNRARR;
    UM; QUAD 2*L_QD1 A QD1 ; {2 QD1} SMAPS 43 MAPARR SPNRARR;
    UM; DL L_O2 ; {O2} SMAPS 44 MAPARR SPNRARR;
    UM; DL L_OBM ; {OBM} SMAPS 45 MAPARR SPNRARR;
    UM; DL L_O2 ; {O2} SMAPS 46 MAPARR SPNRARR;
    UM; QUAD L_QF1 A QF1 ; {QF1} SMAPS 47 MAPARR SPNRARR;
  
ENDPROCEDURE;

{elem-counting: 47 = 47}
SAVE 'magnetic_sextupoles_maps';
