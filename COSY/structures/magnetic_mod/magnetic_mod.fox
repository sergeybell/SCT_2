{ ************************************************************ }
{ COSY Infinity Lattice Converter }
{ Purpose: Conversion from MADX to COSY Infinity }
{ Author: Kolokolchikov S. }
{ Date: 2026-05-01 16:37:45 }
{ Input file: C:/GIT_REPOS/SCT/MADX/1.Sequences/magnetic_mod.seq }
{ TOTAL ELEMENTS: 100 }
{ ************************************************************ }

INCLUDE 'header';

PROCEDURE LATTICE SEXTGx1 SEXTGy1 SEXTGx2 SEXTGy2 EB1 RFFLAG;
 VARIABLE VRF 1 1 1; VARIABLE FREQ 1; VARIABLE HNUM 1; VARIABLE I 1;
 VARIABLE A 1; VARIABLE EBE 1;
 VARIABLE L_BM 1;
 VARIABLE ANG_BM 1;
 VARIABLE L_OBM 1;
 VARIABLE L_O2 1;
 VARIABLE L_QF 1;
 VARIABLE QF 1;
 VARIABLE L_QD 1;
 VARIABLE QD 1;
 VARIABLE L_QF1 1;
 VARIABLE QF1 1;
 VARIABLE L_QD1 1;
 VARIABLE QD1 1;
 VARIABLE L_O1 1;
 VARIABLE SF1 1; VARIABLE SF2 1; VARIABLE SD 1; VARIABLE SD1 1;
 VARIABLE LEN_S 1;

 {LATTICE PARAMETERS}
 EBE := EB1; A := 0.05;
 SF1 := SEXTGx1; SF2 := SEXTGx2; SD := SEXTGy1; SD1 := SEXTGy2;
 LEN_S := 0.15;
  
 {ELEMENT VALUES FROM MADX}
 L_BM := 5.3294148;
 ANG_BM := 0.3926990754;
 L_OBM := 5.3294148;
 L_O2 := 0.25;
 L_QF := 0.21;
 QF := 0.4803696115;
 L_QD := 0.21;
 QD := -0.5393371387;
 L_QF1 := 0.21;
 QF1 := 0.5462981833;
 L_QD1 := 0.21;
 QD1 := -0.4602343583;
 L_O1 := 0.1;

 {SETTING RF PARAMETERS}
 HNUM := 66; VRF(1, 1) := 100/HNUM; FREQ := HNUM*REVFREQ(fACCLEN(1));
 UM; CR; IF RFFLAG=1; RF VRF 0 FREQ 0 0.05; ENDIF;

 {BEGIN LATTICE}
LOOP I 1 2;
 QUAD L_QF A QF ; {QF}
 DL L_O2 ; {O2}
 SBEND L_BM ANG_BM 0 0 0 0 0 0.5 0.5 ; {BM}
 DL L_O2 ; {O2}
 QUAD 2*L_QD A QD ; {2 QD}
 DL L_O2 ; {O2}
 SBEND L_BM ANG_BM 0 0 0 0 0 0.5 0.5 ; {BM}
 DL L_O1 ; {O1}
 MH LEN_S SF1 0.05; {SF1}
 QUAD 2*L_QF A QF ; {2 QF}
 DL L_O2 ; {O2}
 SBEND L_BM ANG_BM 0 0 0 0 0 0.5 0.5 ; {BM}
 DL L_O1 ; {O1}
 MH LEN_S SD 0.05; {SD}
 QUAD 2*L_QD A QD ; {2 QD}
 DL L_O2 ; {O2}
 SBEND L_BM ANG_BM 0 0 0 0 0 0.5 0.5 ; {BM}
 DL L_O1 ; {O1}
 MH LEN_S SF2 0.05; {SF2}
 QUAD 2*L_QF A QF ; {2 QF}
 DL L_O2 ; {O2}
 SBEND L_BM ANG_BM 0 0 0 0 0 0.5 0.5 ; {BM}
 DL L_O1 ; {O1}
 MH LEN_S SD 0.05; {SD}
 QUAD 2*L_QD A QD ; {2 QD}
 DL L_O2 ; {O2}
 SBEND L_BM ANG_BM 0 0 0 0 0 0.5 0.5 ; {BM}
 DL L_O1 ; {O1}
 MH LEN_S SF1 0.05; {SF1}
 QUAD 2*L_QF A QF ; {2 QF}
 DL L_O2 ; {O2}
 SBEND L_BM ANG_BM 0 0 0 0 0 0.5 0.5 ; {BM}
 DL L_O2 ; {O2}
 QUAD 2*L_QD A QD ; {2 QD}
 DL L_O2 ; {O2}
 SBEND L_BM ANG_BM 0 0 0 0 0 0.5 0.5 ; {BM}
 DL L_O2 ; {O2}
 QUAD L_QF A QF ; {QF}
 QUAD L_QF1 A QF1 ; {QF1}
 DL L_O2 ; {O2}
 DL L_OBM ; {OBM}
 DL L_O2 ; {O2}
 QUAD 2*L_QD1 A QD1 ; {2 QD1}
 DL L_O2 ; {O2}
 DL L_OBM ; {OBM}
 DL L_O2 ; {O2}
 QUAD L_QF1 A QF1 ; {QF1}
ENDLOOP;

ENDPROCEDURE;
SAVE 'magnetic_mod';