{ Equilibrium check of one ring.
  Default module: magnetic_2 (deuteron, gamma below).
  electrostatic_mh is SAVE 'electrostatic_mh' (proton).
  The QFS file Nuclotron_16.fox saves the module seq_Nuclotron_16, not Nuclotron_16.
  Switch INCLUDE, GAMMA and SET_FOR_* together. Do not change the lattices.
  Output: ../dat/<structure>/equilibrium.dat
  The directory must already exist (run_cosy.py --lattice <stem>).
  Map for the coefficients is built with RF = 0. Chromaticity is a second
  static map, OV 3 2 1, converted by (1+1/gamma). }
INCLUDE 'magnetic_2';
{INCLUDE 'electrostatic_mh';}
{INCLUDE 'seq_Nuclotron_16';}

PROCEDURE MAIN;
    VARIABLE SGx1 1; VARIABLE SGy1 1; VARIABLE SGx2 1; VARIABLE SGy2 1;
    VARIABLE EB1 1; VARIABLE RF 1;
    VARIABLE GAMMA 1; VARIABLE BETA2 1; VARIABLE KG 1; VARIABLE CS 1;
    VARIABLE structure 25;
    VARIABLE L6 1; VARIABLE L66 1;
    VARIABLE E1 1; VARIABLE E2 1;
    VARIABLE A0 1; VARIABLE A1 1;
    VARIABLE ETA0 1; VARIABLE ETA1 1;
    VARIABLE ETA0_0 1; VARIABLE ETA1_0 1; VARIABLE ETA_MAG 1;
    VARIABLE T1 1; VARIABLE T2 1; VARIABLE T3 1; VARIABLE T4 1;
    VARIABLE T11 1; VARIABLE T12 1; VARIABLE T22 1;
    VARIABLE T33 1; VARIABLE T34 1; VARIABLE T44 1;
    VARIABLE X11 1; VARIABLE X12 1; VARIABLE X22 1;
    VARIABLE P11 1; VARIABLE P12 1; VARIABLE P22 1;
    VARIABLE X33 1; VARIABLE X34 1; VARIABLE X44 1;
    VARIABLE P33 1; VARIABLE P34 1; VARIABLE P44 1;
    VARIABLE Y33 1; VARIABLE Y34 1; VARIABLE Y44 1;
    VARIABLE B33 1; VARIABLE B34 1; VARIABLE B44 1;
    VARIABLE R11 1; VARIABLE R12 1; VARIABLE R21 1; VARIABLE R22 1;
    VARIABLE S11 1; VARIABLE S12 1; VARIABLE S21 1; VARIABLE S22 1;
    VARIABLE CX 1; VARIABLE SX 1; VARIABLE AX 1; VARIABLE BX 1; VARIABLE GX 1;
    VARIABLE CY 1; VARIABLE SY 1; VARIABLE AY 1; VARIABLE BY 1; VARIABLE GY 1;
    VARIABLE DETX 1; VARIABLE DETY 1;
    VARIABLE KX 1; VARIABLE KP 1; VARIABLE XC 1; VARIABLE PC 1;
    VARIABLE KYX 1; VARIABLE KYP 1; VARIABLE XCY 1; VARIABLE PCY 1;
    VARIABLE KY 1; VARIABLE KB 1; VARIABLE YC 1; VARIABLE BC 1;
    VARIABLE DLX 1; VARIABLE DLY 1; VARIABLE LTX 1; VARIABLE LTY 1;
    VARIABLE LTX_ELL 1; VARIABLE LTY_ELL 1;
    VARIABLE XIX 1; VARIABLE XIY 1; VARIABLE LTX_XI 1; VARIABLE LTY_XI 1;
    VARIABLE PI 1; VARIABLE G2 1; VARIABLE G4 1; VARIABLE TERM 1;
    VARIABLE TL 800; VARIABLE TA 800;
    VARIABLE MU_TP 800 3;

    structure := 'magnetic_2';
    GAMMA := 1.143914;
    { electrostatic_mh, proton 233 MeV: GAMMA := 1.248329; SET_FOR_PROTONS }
    PI := 4*ATAN(1);
    BETA2 := 1-1/(GAMMA*GAMMA);
    KG := (GAMMA+1)/GAMMA;
    SGx1 := 0; SGy1 := 0; SGx2 := 0; SGy2 := 0; EB1 := 0;
    RF := 0;

    { --- static 6D map, no cavity --- }
    OV 3 3 0;
    SET_FOR_DEUTERONS GAMMA;
    {SET_FOR_PROTONS GAMMA;}
    UM; LATTICE SGx1 SGy1 SGx2 SGy2 EB1 RF;
    CS := SPOS;

    { Origin, canonical delta_K. Monomial coefficients (factorials already in). }
    L6 := MAP(5)|(0&0&0&0&0&1);
    L66 := MAP(5)|(0&0&0&0&0&2);
    T1 := MAP(5)|(1&0&0&0&0&0);
    T2 := MAP(5)|(0&1&0&0&0&0);
    T3 := MAP(5)|(0&0&1&0&0&0);
    T4 := MAP(5)|(0&0&0&1&0&0);
    T11 := MAP(5)|(2&0&0&0&0&0);
    T12 := MAP(5)|(1&1&0&0&0&0);
    T22 := MAP(5)|(0&2&0&0&0&0);
    T33 := MAP(5)|(0&0&2&0&0&0);
    T34 := MAP(5)|(0&0&1&1&0&0);
    T44 := MAP(5)|(0&0&0&2&0&0);

    X11 := MAP(1)|(2&0&0&0&0&0);
    X12 := MAP(1)|(1&1&0&0&0&0);
    X22 := MAP(1)|(0&2&0&0&0&0);
    P11 := MAP(2)|(2&0&0&0&0&0);
    P12 := MAP(2)|(1&1&0&0&0&0);
    P22 := MAP(2)|(0&2&0&0&0&0);
    X33 := MAP(1)|(0&0&2&0&0&0);
    X34 := MAP(1)|(0&0&1&1&0&0);
    X44 := MAP(1)|(0&0&0&2&0&0);
    P33 := MAP(2)|(0&0&2&0&0&0);
    P34 := MAP(2)|(0&0&1&1&0&0);
    P44 := MAP(2)|(0&0&0&2&0&0);
    Y33 := MAP(3)|(0&0&2&0&0&0);
    Y34 := MAP(3)|(0&0&1&1&0&0);
    Y44 := MAP(3)|(0&0&0&2&0&0);
    B33 := MAP(4)|(0&0&2&0&0&0);
    B34 := MAP(4)|(0&0&1&1&0&0);
    B44 := MAP(4)|(0&0&0&2&0&0);

    R11 := ME(1,1); R12 := ME(1,2); R21 := ME(2,1); R22 := ME(2,2);
    S11 := ME(3,3); S12 := ME(3,4); S21 := ME(4,3); S22 := ME(4,4);

    CX := (R11+R22)/2;
    SX := SQRT(1-CX*CX);
    IF R12<0; SX := -SX; ENDIF;
    BX := R12/SX;
    AX := (R11-R22)/(2*SX);
    GX := (1+AX*AX)/BX;

    CY := (S11+S22)/2;
    SY := SQRT(1-CY*CY);
    IF S12<0; SY := -SY; ENDIF;
    BY := S12/SY;
    AY := (S11-S22)/(2*SY);
    GY := (1+AY*AY)/BY;

    { Horizontal ellipse: in-plane centre. (I-R) (xc, pc) = <M-z>. }
    KX := X11*BX - X12*AX + X22*GX;
    KP := P11*BX - P12*AX + P22*GX;
    DETX := (1-R11)*(1-R22) - R12*R21;
    XC := ((1-R22)*KX + R12*KP)/DETX;
    PC := (R21*KX + (1-R11)*KP)/DETX;
    LTX_ELL := T11*BX - T12*AX + T22*GX;
    DLX := LTX_ELL + T1*XC + T2*PC;

    { Vertical ellipse: its own centre, plus the horizontal centre it drives. }
    KY := Y33*BY - Y34*AY + Y44*GY;
    KB := B33*BY - B34*AY + B44*GY;
    DETY := (1-S11)*(1-S22) - S12*S21;
    YC := ((1-S22)*KY + S12*KB)/DETY;
    BC := (S21*KY + (1-S11)*KB)/DETY;
    KYX := X33*BY - X34*AY + X44*GY;
    KYP := P33*BY - P34*AY + P44*GY;
    XCY := ((1-R22)*KYX + R12*KYP)/DETX;
    PCY := (R21*KYX + (1-R11)*KYP)/DETX;
    LTY_ELL := T33*BY - T34*AY + T44*GY;
    DLY := LTY_ELL + T3*YC + T4*BC + T1*XCY + T2*PCY;

    { dl/dJ -> (T-Ts)/Ts per unit action. }
    LTX := -KG*DLX/CS;
    LTY := -KG*DLY/CS;
    LTX_ELL := -KG*LTX_ELL/CS;
    LTY_ELL := -KG*LTY_ELL/CS;

    { Closed-orbit time in canonical variables, then path in delta_p.
      MCM rewrites MAP; call it after every canonical coefficient is stored. }
    ECM MAP SPOS TL;
    E1 := TL|(0&0&0&0&0&1);
    E2 := TL|(0&0&0&0&0&2);
    MCM MAP SPOS TA;
    A0 := -TA|(0&0&0&0&0&1);
    A1 := -TA|(0&0&0&0&0&2);

    G2 := GAMMA*GAMMA;
    G4 := G2*G2;
    ETA0 := -(KG*KG)*E1/CS;
    TERM := E1*KG/(2*G2) + E2*KG*KG;
    ETA1 := -(KG/CS)*TERM;
    ETA0_0 := -(KG*KG)*L6/CS;
    TERM := L6*KG/(2*G2) + L66*KG*KG;
    ETA1_0 := -(KG/CS)*TERM;
    ETA_MAG := A1 + (3/2)*BETA2/G2 - A0/G2 + 1/G4;

    { --- chromaticity, static ring, parameter = delta_K --- }
    OV 3 2 1;
    SET_FOR_DEUTERONS_CHROM GAMMA;
    {SET_FOR_PROTONS_CHROM GAMMA;}
    UM; LATTICE SGx1 SGy1 SGx2 SGy2 EB1 RF;
    TP MU_TP;
    XIX := (MU_TP(1)|(0&0&0&0&1))*(1+1/GAMMA);
    XIY := (MU_TP(2)|(0&0&0&0&1))*(1+1/GAMMA);
    LTX_XI := -2*PI*XIX/CS;
    LTY_XI := -2*PI*XIY/CS;

    OPENF 3633 '../dat/'&structure&'/equilibrium.dat' 'REPLACE';
    WRITE 3633 'gamma Cs alpha0 alpha1';
    WRITE 3633 'eta0_time eta1_time eta0_origin eta1_origin eta1_path';
    WRITE 3633 'LT_Jx LT_Jy LT_ell_Jx LT_ell_Jy';
    WRITE 3633 'xi_x xi_y LT_xi_x LT_xi_y';
    WRITE 3633 ST(GAMMA)&' '&ST(CS)&' '&ST(A0)&' '&ST(A1);
    WRITE 3633 ST(ETA0)&' '&ST(ETA1)&' '&ST(ETA0_0)&' '&ST(ETA1_0)&' '&ST(ETA_MAG);
    WRITE 3633 ST(LTX)&' '&ST(LTY)&' '&ST(LTX_ELL)&' '&ST(LTY_ELL);
    WRITE 3633 ST(XIX)&' '&ST(XIY)&' '&ST(LTX_XI)&' '&ST(LTY_XI);
    CLOSEF 3633;

    WRITE 6 'equilibrium Cs alpha0 alpha1 eta0 eta1 eta_mag LTx LTy LTx_xi';
    WRITE 6 CS; WRITE 6 A0; WRITE 6 A1;
    WRITE 6 ETA0; WRITE 6 ETA1; WRITE 6 ETA_MAG;
    WRITE 6 LTX; WRITE 6 LTY; WRITE 6 LTX_XI;
    WRITE 6 'L6 E1 L66 E2 T11 T12 T22 BX AX GX KX XC';
    WRITE 6 L6; WRITE 6 E1; WRITE 6 L66; WRITE 6 E2;
    WRITE 6 T11; WRITE 6 T12; WRITE 6 T22;
    WRITE 6 BX; WRITE 6 AX; WRITE 6 GX;
    WRITE 6 KX; WRITE 6 XC;
    WRITE 6 'T33 T34 T44 BY AY GY';
    WRITE 6 T33; WRITE 6 T34; WRITE 6 T44;
    WRITE 6 BY; WRITE 6 AY; WRITE 6 GY;
    WRITE 6 XIX; WRITE 6 XIY; WRITE 6 LTX_ELL; WRITE 6 LTY_ELL;
ENDPROCEDURE;

PROCEDURE RUN;
    MAIN;
ENDPROCEDURE;
RUN; END;
