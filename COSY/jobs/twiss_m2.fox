{ Twiss of magnetic_2: sextupoles off, RF off.
  Writes s, value, element to ../dat/magnetic_2/BETAX, BETAY, DISPX. }
INCLUDE 'magnetic_2_maps';

PROCEDURE PICK INDEX MAPARR SPNRARR;
    VARIABLE I 1; VARIABLE J 1;
    LOOP I 1 TWOND;
        MSC(I) := MAPARR(I, INDEX);
    ENDLOOP;
    LOOP I 1 3;
        LOOP J 1 3;
            SSCR(I,J) := SPNRARR(I,J,INDEX) + 0*DD(1);
        ENDLOOP;
    ENDLOOP;
ENDPROCEDURE;

PROCEDURE GETTWISS0 COORD AL0 BET0 GAM0;
    VARIABLE NUM1 1; VARIABLE NUM2 1; VARIABLE OBJ 1;
    IF COORD='X'; NUM1:=1; NUM2:=2;
        ELSEIF COORD='Y'; NUM1:=3; NUM2:=4;
        ELSEIF LO(1); WRITE 6 'UNKNOWN COORDINATE';
    ENDIF;
    FIT AL0 BET0 GAM0;
        OBJ:= SQR(SQR(ME(NUM1,NUM1))*BET0-2*ME(NUM1,NUM1)*ME(NUM1,NUM2)*AL0+SQR(ME(NUM1,NUM2))*GAM0-BET0);
        OBJ:=OBJ+ SQR(-ME(NUM1,NUM1)*ME(NUM2,NUM1)*BET0+( ME(NUM1,NUM1)*ME(NUM2,NUM2)+ME(NUM1,NUM2)*ME(NUM2,NUM1) )*AL0-ME(NUM1,NUM2)*ME(NUM2,NUM2)*GAM0-AL0);
        OBJ:=OBJ+ SQR((ME(NUM2,NUM1)^2)*BET0-2*ME(NUM2,NUM1)*ME(NUM2,NUM2)*AL0+(ME(NUM2,NUM2)^2)*GAM0-(1+AL0^2)/BET0);
    ENDFIT 1E-20 5000 1 OBJ;
    WRITE 6 'TWISS '&COORD&' alpha beta gamma';
    WRITE 6 AL0; WRITE 6 BET0; WRITE 6 GAM0;
ENDPROCEDURE;

PROCEDURE GETDISP0 COORD D0 DPR0;
    VARIABLE NUM1 1; VARIABLE NUM2 1; VARIABLE OBJ 1;
    IF COORD='X'; NUM1:=1; NUM2:=2;
        ELSEIF COORD='Y'; NUM1:=3; NUM2:=4;
        ELSEIF LO(1); WRITE 6 'UNKNOWN COORDINATE';
    ENDIF;
    FIT D0 DPR0;
        OBJ:= SQR(  ME(NUM1,NUM1)*D0+ME(NUM1,NUM2)*DPR0+ME(NUM1,6)*(1+1/(CONS(ETA)+1))-D0  );
        OBJ:=OBJ+ SQR(  ME(NUM2,NUM1)*D0+ME(NUM2,NUM2)*DPR0+ME(NUM2,6)*(1+1/(CONS(ETA)+1))-DPR0  );
    ENDFIT 1E-20 5000 1 OBJ;
    WRITE 6 'DISP '&COORD&' D Dp';
    WRITE 6 D0; WRITE 6 DPR0;
ENDPROCEDURE;

PROCEDURE MAIN;
    VARIABLE GAMMA 1;
    VARIABLE SGx1 1; VARIABLE SGx2 1; VARIABLE SGy1 1; VARIABLE SGy2 1; VARIABLE EB1 1;
    VARIABLE ALPHAX0 1; VARIABLE BETAX0 1; VARIABLE GAMMAX0 1;
    VARIABLE ALPHAY0 1; VARIABLE BETAY0 1; VARIABLE GAMMAY0 1;
    VARIABLE DISPX0 1; VARIABLE DISPXPR0 1;
    VARIABLE MAPARR1 1000 6 600; VARIABLE SPNRARR1 1000 3 3 600;
    VARIABLE NUM_ELE 1;
    VARIABLE J 1; VARIABLE BX 1; VARIABLE BY 1; VARIABLE DX 1;
    VARIABLE ELEN 1 84; VARIABLE SACC 1;
    VARIABLE structure 25;

    structure := 'magnetic_2';
    GAMMA := 1.143914;
    OV 3 3 0;
    SET_FOR_DEUTERONS GAMMA;
    EB1 := 0;
    SGx1 := 0.0; SGx2 := 0.0;
    SGy1 := 0.0; SGy2 := 0.0;
    NUM_ELE := 84;
    BETAX0:=19.3675; ALPHAX0:=-0.000251909;
    BETAY0:=4.05447; ALPHAY0:=-0.000188151;
    DISPX0:=0.0; DISPXPR0:=-0.00050616;
    GAMMAX0:=(1+SQR(ALPHAX0))/BETAX0;
    GAMMAY0:=(1+SQR(ALPHAY0))/BETAY0;

    ELEN(1):=0.06; ELEN(2):=0.21; ELEN(3):=5.3294148; ELEN(4):=0.21;
    ELEN(5):=0.12; ELEN(6):=0.21; ELEN(7):=5.3294148; ELEN(8):=0.21;
    ELEN(9):=0.12; ELEN(10):=0.21; ELEN(11):=5.3294148; ELEN(12):=0.21;
    ELEN(13):=0.12; ELEN(14):=0.21; ELEN(15):=5.3294148; ELEN(16):=0.21;
    ELEN(17):=0.12; ELEN(18):=0.21; ELEN(19):=5.3294148; ELEN(20):=0.21;
    ELEN(21):=0.12; ELEN(22):=0.21; ELEN(23):=5.3294148; ELEN(24):=0.21;
    ELEN(25):=0.12; ELEN(26):=0.21; ELEN(27):=5.3294148; ELEN(28):=0.21;
    ELEN(29):=0.12; ELEN(30):=0.21; ELEN(31):=5.3294148; ELEN(32):=0.21;
    ELEN(33):=0.06; ELEN(34):=0.06; ELEN(35):=0.21; ELEN(36):=5.3294148;
    ELEN(37):=0.21; ELEN(38):=0.12; ELEN(39):=0.21; ELEN(40):=5.3294148;
    ELEN(41):=0.21; ELEN(42):=0.06; ELEN(43):=0.06; ELEN(44):=0.21;
    ELEN(45):=5.3294148; ELEN(46):=0.21; ELEN(47):=0.12; ELEN(48):=0.21;
    ELEN(49):=5.3294148; ELEN(50):=0.21; ELEN(51):=0.12; ELEN(52):=0.21;
    ELEN(53):=5.3294148; ELEN(54):=0.21; ELEN(55):=0.12; ELEN(56):=0.21;
    ELEN(57):=5.3294148; ELEN(58):=0.21; ELEN(59):=0.12; ELEN(60):=0.21;
    ELEN(61):=5.3294148; ELEN(62):=0.21; ELEN(63):=0.12; ELEN(64):=0.21;
    ELEN(65):=5.3294148; ELEN(66):=0.21; ELEN(67):=0.12; ELEN(68):=0.21;
    ELEN(69):=5.3294148; ELEN(70):=0.21; ELEN(71):=0.12; ELEN(72):=0.21;
    ELEN(73):=5.3294148; ELEN(74):=0.21; ELEN(75):=0.06; ELEN(76):=0.06;
    ELEN(77):=0.21; ELEN(78):=5.3294148; ELEN(79):=0.21; ELEN(80):=0.12;
    ELEN(81):=0.21; ELEN(82):=5.3294148; ELEN(83):=0.21; ELEN(84):=0.06;

    LATTICE SGx1 SGy1 SGx2 SGy2 EB1 0 MAPARR1 SPNRARR1;

    UM;
    LOOP J 1 NUM_ELE;
        PICK J MAPARR1 SPNRARR1;
        LOCSET 0 0 0 0 0 0;
        UPDATE 1 1;
    ENDLOOP;
    GETTWISS0 'X' ALPHAX0 BETAX0 GAMMAX0;
    GETTWISS0 'Y' ALPHAY0 BETAY0 GAMMAY0;
    GETDISP0 'X' DISPX0 DISPXPR0;
    GAMMAX0:=(1+SQR(ALPHAX0))/BETAX0;
    GAMMAY0:=(1+SQR(ALPHAY0))/BETAY0;

    OPENF 800 '../dat/'&structure&'/BETAX' 'REPLACE';
    OPENF 801 '../dat/'&structure&'/BETAY' 'REPLACE';
    OPENF 802 '../dat/'&structure&'/DISPX' 'REPLACE';
    WRITE 800 's_m beta_m element';
    WRITE 801 's_m beta_m element';
    WRITE 802 's_m D_m element';
    WRITE 800 ST(0)&' '&ST(BETAX0)&' '&ST(0);
    WRITE 801 ST(0)&' '&ST(BETAY0)&' '&ST(0);
    WRITE 802 ST(0)&' '&ST(DISPX0)&' '&ST(0);

    UM; SACC := 0;
    LOOP J 1 NUM_ELE;
        PICK J MAPARR1 SPNRARR1;
        LOCSET 0 0 0 0 0 0;
        UPDATE 1 1;
        SACC := SACC+ELEN(J);
        BX := (ME(1,1)^2)*BETAX0-2*ME(1,1)*ME(1,2)*ALPHAX0+(ME(1,2)^2)*GAMMAX0;
        BY := (ME(3,3)^2)*BETAY0-2*ME(3,3)*ME(3,4)*ALPHAY0+(ME(3,4)^2)*GAMMAY0;
        DX := ME(1,1)*DISPX0+ME(1,2)*DISPXPR0+ME(1,6)*(1+1/(CONS(ETA)+1));
        WRITE 800 ST(SACC)&' '&ST(BX)&' '&ST(J);
        WRITE 801 ST(SACC)&' '&ST(BY)&' '&ST(J);
        WRITE 802 ST(SACC)&' '&ST(DX)&' '&ST(J);
    ENDLOOP;
    CLOSEF 800; CLOSEF 801; CLOSEF 802;
    WRITE 6 'twiss_m2 wrote BETAX BETAY DISPX Cs='&ST(SACC);
ENDPROCEDURE;

PROCEDURE RUN;
    MAIN;
ENDPROCEDURE;
RUN; END;
